{
    "name": "horde/pdf",
    "description": "PDF writer library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Pdf",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "lead"
        },
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Mike Naberezny",
            "email": "mike@maintainable.com",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        }
    ],
    "keywords": [
        "iso32000"
    ],
    "time": "2026-05-25",
    "repositories": [],
    "require": {
        "php": "^8.1",
        "horde/exception": "^3 || dev-FRAMEWORK_6_0",
        "horde/util": "^3 || dev-FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/xml_element": "dev-FRAMEWORK_6_0 || dev-FRAMEWORK_6_0"
    },
    "suggest": {
        "horde/test": "^3 || dev-FRAMEWORK_6_0",
        "horde/xml_element": "^3 || dev-FRAMEWORK_6_0"
    },
    "autoload": {
        "psr-0": {
            "Horde_Pdf": "lib/"
        },
        "psr-4": {
            "Horde\\Pdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Pdf\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}